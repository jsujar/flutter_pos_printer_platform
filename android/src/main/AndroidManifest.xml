<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.sersoluciones.flutter_pos_printer_platform">

    <!--
      USB-only fork (2026-09-11). Seven permissions used to live here, and every
      host app inherited them without declaring them: BLUETOOTH, BLUETOOTH_ADMIN,
      BLUETOOTH_SCAN, BLUETOOTH_ADVERTISE, BLUETOOTH_CONNECT,
      ACCESS_FINE_LOCATION and ACCESS_COARSE_LOCATION, plus a bluetooth
      uses-feature.

      None of them is needed to print over USB. Permission for the USB device is
      granted by the user through the system dialog and is not declared here.
    -->
</manifest>
